<Window x:Class="Planify.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Planify · Windows">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>
     <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SidebarBrush" Color="#F1F2F5"/><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="DividerBrush" Color="#16000000"/></ResourceDictionary>
     <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SidebarBrush" Color="#19191E"/><SolidColorBrush x:Key="CardBrush" Color="#202026"/><SolidColorBrush x:Key="DividerBrush" Color="#22FFFFFF"/></ResourceDictionary>
     <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="SidebarBrush" Color="Black"/><SolidColorBrush x:Key="CardBrush" Color="Black"/><SolidColorBrush x:Key="DividerBrush" Color="White"/></ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="TileStyle" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,9"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
   <Grid Padding="14,12" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Planify" FontWeight="SemiBold" FontSize="21" Margin="10,2"/><Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Click="Account_Click" ToolTipService.ToolTip="账户设置" AutomationProperties.Name="账户设置"><FontIcon Glyph="&#xE713;" FontSize="17"/></Button></Grid>
    <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="8">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="AllTile" Tag="all" Style="{StaticResource TileStyle}" Background="#203584E4" Foreground="#3584E4" Click="View_Click"><StackPanel Spacing="5"><Grid><FontIcon Glyph="&#xE8B7;" FontSize="16" HorizontalAlignment="Left"/><TextBlock x:Name="AllCount" HorizontalAlignment="Right" Text="0"/></Grid><TextBlock Text="全部任务" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="TodayTile" Grid.Column="1" Tag="today" Style="{StaticResource TileStyle}" Background="#2033B879" Foreground="#27A66A" Click="View_Click"><StackPanel Spacing="5"><Grid><FontIcon Glyph="&#xE734;" FontSize="16" HorizontalAlignment="Left"/><TextBlock x:Name="TodayCount" HorizontalAlignment="Right" Text="0"/></Grid><TextBlock Text="今天" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="ScheduledTile" Grid.Row="1" Tag="scheduled" Style="{StaticResource TileStyle}" Background="#209B59CF" Foreground="#A267CB" Click="View_Click"><StackPanel Spacing="5"><Grid><FontIcon Glyph="&#xE787;" FontSize="16" HorizontalAlignment="Left"/><TextBlock x:Name="ScheduledCount" HorizontalAlignment="Right" Text="0"/></Grid><TextBlock Text="计划" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="PendingTile" Grid.Row="1" Grid.Column="1" Tag="pending" Style="{StaticResource TileStyle}" Background="#20D19A30" Foreground="#BD8824" Click="View_Click"><StackPanel Spacing="5"><Grid><FontIcon Glyph="&#xE895;" FontSize="16" HorizontalAlignment="Left"/><TextBlock x:Name="PendingCount" HorizontalAlignment="Right" Text="0"/></Grid><TextBlock Text="待同步" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="ConflictTile" Grid.Row="2" Tag="conflicts" Style="{StaticResource TileStyle}" Background="#20E05262" Foreground="#D85363" Click="View_Click"><StackPanel Spacing="5"><Grid><FontIcon Glyph="&#xE7BA;" FontSize="16" HorizontalAlignment="Left"/><TextBlock x:Name="ConflictCount" HorizontalAlignment="Right" Text="0"/></Grid><TextBlock Text="冲突" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="CompletedTile" Grid.Row="2" Grid.Column="1" Tag="completed" Style="{StaticResource TileStyle}" Background="#20E78D31" Foreground="#D28024" Click="View_Click"><StackPanel Spacing="5"><Grid><FontIcon Glyph="&#xE73E;" FontSize="16" HorizontalAlignment="Left"/><TextBlock x:Name="CompletedCount" HorizontalAlignment="Right" Text="0"/></Grid><TextBlock Text="已完成" FontWeight="SemiBold"/></StackPanel></Button>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="6" Margin="8,8,8,0"><TextBlock x:Name="AccountLabel" Text="Nextcloud" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ConnectionLabel" Text="尚未连接 · 点击齿轮设置账户" FontSize="12" Opacity="0.6"/><Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,4,0,0"/></StackPanel>
    <ListView x:Name="Lists" Grid.Row="3" SelectionChanged="Lists_Changed" SelectionMode="Single">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,2"/><Setter Property="MinHeight" Value="42"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="○" Foreground="{Binding Color}" FontSize="25" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Opacity="0.5" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Button Grid.Row="4" Click="Account_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE77B;" FontSize="15"/><TextBlock Text="账户与连接"/></StackPanel></Button>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="26,14">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="PageTitle" Text="全部任务" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="把今天的事情，一件件完成。" FontSize="12" Opacity="0.6"/></StackPanel>
     <Button x:Name="SyncButton" Grid.Column="1" Content="同步所有列表" Click="Sync_Click" IsEnabled="False" VerticalAlignment="Center"/>
     <Button Grid.Column="2" Content="···" VerticalAlignment="Center" AutomationProperties.Name="更多操作"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="CurrentSyncButton" Text="仅同步当前列表" Click="CurrentSync_Click" IsEnabled="False"/><MenuFlyoutItem Text="账户设置" Click="Account_Click"/></MenuFlyout></Button.Flyout></Button>
    </Grid>
   </Border>
   <Grid Grid.Row="1" x:Name="ContentArea">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorColumn" Width="0"/></Grid.ColumnDefinitions>
    <Grid Padding="24,18,24,20" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" PlaceholderText="搜索当前视图" TextChanged="Search_Changed" BorderThickness="0" Background="{ThemeResource SidebarBrush}" CornerRadius="8"/><CheckBox Grid.Column="1" x:Name="ShowCompleted" Content="显示已完成" IsChecked="False" Click="ShowCompleted_Click" FontSize="12"/></Grid>
     <Grid Grid.Row="1">
      <ListView x:Name="Tasks" SelectionChanged="Task_Changed" SelectionMode="Single">
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate><DataTemplate><Border Background="{ThemeResource CardBrush}" CornerRadius="8" Padding="14" HorizontalAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="{Binding CheckGlyph}" Tag="{Binding Entry}" IsEnabled="{Binding CanEdit}" Click="Complete_Click" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="14" Background="Transparent" BorderBrush="{ThemeResource DividerBrush}" VerticalAlignment="Top" ToolTipService.ToolTip="完成 / 重新打开任务" AutomationProperties.Name="切换任务完成状态"/>
        <StackPanel Grid.Column="1" Spacing="6" Opacity="{Binding Opacity}"><TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Metadata}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
       </Grid></Border></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False"><FontIcon Glyph="&#xE73E;" FontSize="38" Opacity="0.25"/><TextBlock x:Name="EmptyTitle" Text="这里还没有任务" FontSize="18" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="连接 Nextcloud，然后同步你的列表。" Opacity="0.55" TextWrapping="Wrap" MaxWidth="330" TextAlignment="Center"/></StackPanel>
     </Grid>
     <Button x:Name="AddButton" Grid.Row="2" Click="New_Click" HorizontalAlignment="Right" CornerRadius="24" Width="48" Height="48" Padding="0" Background="#3584E4" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="新建任务" AutomationProperties.Name="新建任务"><FontIcon Glyph="&#xE710;" FontSize="20"/></Button>
    </Grid>
    <Border Grid.Column="1" x:Name="EditorPanel" Visibility="Collapsed" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0" Padding="22">
     <ScrollViewer><StackPanel Spacing="15">
      <Grid><TextBlock x:Name="EditorHeading" Text="任务详情" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="×" Click="CloseEditor_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="关闭详情"/></Grid>
      <ComboBox x:Name="Destination" Header="任务列表" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
      <TextBox x:Name="TaskTitle" Header="标题" TextWrapping="Wrap"/>
      <TextBox x:Name="TaskNotes" Header="备注" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170"/>
      <CheckBox x:Name="Done" Content="已完成"/>
      <TextBlock x:Name="TaskInfo" TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
      <Button x:Name="SaveButton" Content="保存任务" Click="Save_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
      <Button x:Name="DeleteButton" Content="删除任务…" Click="Delete_Click" Background="Transparent" HorizontalAlignment="Stretch"/>
      <Button x:Name="ResolveButton" Content="采用服务器版本…" Click="Resolve_Click" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,10"><StackPanel Spacing="6"><ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="从账户设置连接 Nextcloud，即可同步所有列表。" FontSize="12" Opacity="0.7" TextWrapping="Wrap" MaxHeight="90"/></StackPanel></Border>
  </Grid>
  <ContentDialog x:Name="AccountDialog" Title="连接 Nextcloud" PrimaryButtonText="连接" CloseButtonText="关闭" PrimaryButtonClick="Connect_Click" DefaultButton="Primary">
   <StackPanel Spacing="12" MinWidth="360">
    <TextBox x:Name="Server" Header="服务器地址" PlaceholderText="https://cloud.example.com/" TextChanged="CredentialAccount_Changed"/>
    <TextBox x:Name="Username" Header="用户名" TextChanged="CredentialAccount_Changed"/>
    <PasswordBox x:Name="Password" Header="应用专用密码" PlaceholderText="输入应用专用密码"/>
    <CheckBox x:Name="RememberPassword" Content="记住密码，下次启动自动连接" IsChecked="False"/>
    <TextBlock x:Name="CredentialStatus" Text="勾选后，连接成功时由 Windows 凭据管理器保存。" TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
    <Button x:Name="ForgetPasswordButton" Content="忘记已保存的密码" Click="ForgetPassword_Click" Visibility="Collapsed"/>
    <TextBlock Text="自动连接不会上传任务修改。点击“同步所有列表”后才会进行双向同步。" TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
    <TextBlock x:Name="AccountError" Foreground="#D85363" TextWrapping="Wrap"/>
   </StackPanel>
  </ContentDialog>
 </Grid>
</Window>
